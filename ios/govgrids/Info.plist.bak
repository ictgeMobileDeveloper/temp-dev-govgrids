<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>GovGrids</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict/>
	</dict>
	<key>NSAppleMusicUsageDescription</key>
	<string>This app may access your media library to enhance your experience with media features.</string>
	<key>NSCameraUsageDescription</key>
	<string>This app requires camera access to capture and upload photos.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>We use your location for better user experience.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>App requires access to your photo library to upload images.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>App requires access to your photo library to upload images.</string>
	<key>RCTNewArchEnabled</key>
	<true/>
	<key>UIAppFonts</key>
	<array>
		<string>Sono-Bold.ttf</string>
		<string>Sono-ExtraBold.ttf</string>
		<string>Sono-ExtraLight.ttf</string>
		<string>Sono-Light.ttf</string>
		<string>Sono-Medium.ttf</string>
		<string>Sono-Regular.ttf</string>
		<string>Sono-SemiBold.ttf</string>
		<string>Sono_Proportional-Bold.ttf</string>
		<string>Sono_Proportional-ExtraBold.ttf</string>
		<string>Sono_Proportional-ExtraLight.ttf</string>
		<string>Sono_Proportional-Light.ttf</string>
		<string>Sono_Proportional-Medium.ttf</string>
		<string>Sono_Proportional-Regular.ttf</string>
		<string>Sono_Proportional-SemiBold.ttf</string>
		<string>UbuntuSans-Bold.ttf</string>
		<string>UbuntuSans-BoldItalic.ttf</string>
		<string>UbuntuSans-ExtraBold.ttf</string>
		<string>UbuntuSans-ExtraBoldItalic.ttf</string>
		<string>UbuntuSans-ExtraLight.ttf</string>
		<string>UbuntuSans-ExtraLightItalic.ttf</string>
		<string>UbuntuSans-Italic.ttf</string>
		<string>UbuntuSans-Light.ttf</string>
		<string>UbuntuSans-LightItalic.ttf</string>
		<string>UbuntuSans-Medium.ttf</string>
		<string>UbuntuSans-MediumItalic.ttf</string>
		<string>UbuntuSans-Regular.ttf</string>
		<string>UbuntuSans-SemiBold.ttf</string>
		<string>UbuntuSans-SemiBoldItalic.ttf</string>
		<string>UbuntuSans-Thin.ttf</string>
		<string>UbuntuSans-ThinItalic.ttf</string>
		<string>Inter-Bold.otf</string>
		<string>Inter-Regular.otf</string>
		<string>Inter-SemiBoldItalic.otf</string>
		<string>Inter-Medium.otf</string>
		<string>Inter-Thin-BETA.otf</string>
		<string>Inter-ExtraLight-BETA.otf</string>
		<string>Inter-Light-BETA.otf</string>
		<string>Inter-ExtraLightItalic-BETA.otf</string>
